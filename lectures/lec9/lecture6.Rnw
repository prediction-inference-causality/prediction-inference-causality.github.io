<<echo=FALSE, warning=FALSE, message=FALSE>>=
source('../../shared-code/plotting.R')
theme_set(simplified.theme)
mu = function(x) { x*10000 }
sigma = function(x) { 10000 }
grades = 0:16
grade = 10
estimation.target = mu(grade)

in.interval = function(X, interval) { interval[1] <= X & X <= interval[2] }
coverage.sim = function(n, grade.range=c(grade,grade), reps=1000) {
  estimates = array(dim=reps)
  stderrs  = array(dim=reps)
  for(rr in 1:reps) {
    # Sample Data
    X = c(grade, grade, sample(grades, n-2, replace=TRUE))
    Y   = mu(X) + sigma(X)*rnorm(n)
    
    in.bin = grade.range[1] <= X & X <= grade.range[2]
    estimates[rr] = mean(Y[in.bin])
    stderrs[rr]   = sqrt( var(Y[in.bin]) / sum(in.bin) )
  }
  list(estimates=estimates, stderrs=stderrs)
}
@



