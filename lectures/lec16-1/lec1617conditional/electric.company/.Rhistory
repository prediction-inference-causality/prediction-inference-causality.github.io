LBvec <- spvec- 1.96*sqrt(spvec*(1-spvec))/sqrt(600)#
UBvec <- spvec+ 1.96*sqrt(spvec*(1-spvec))/sqrt(600)#
#
mean(LBvec < .53 & UBvec  > .53)
