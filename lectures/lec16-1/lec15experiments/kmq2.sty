%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Standard Commands and Re-Definitions %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\usepackage{amsfonts}

\makeatletter
\makeatother
\newcommand{\double}{\setlength{\baselineskip}{.35in}}
\newcommand{\single}{\setlength{\baselineskip}{.175in}}
\textheight 9in
\textwidth 6.5in
\topmargin -.5in
\oddsidemargin 0in
\evensidemargin 0in
\evensidemargin 0in
\newtheorem{theorem}{Theorem}           % Set Counter for Theorems
\newtheorem{hypothesis}{Hypothesis}     % Set Counter for Hypotheses
\newtheorem{proposition}{Proposition}   
\newtheorem{definition}{Definition}
\newtheorem{example}{Example}[section]
\newcounter{fig}                        % Set Counter for Figures
\newcounter{tab}                        % Set Counter for Tables

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Shortcuts for Statistical Work    %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% distributions 
\newcommand{\normdist}[2]{\ensuremath{\mathcal{N}(#1,#2)}}
\newcommand{\normdistk}[3]{\ensuremath{\mathcal{N}_{#3}(#1,#2)}}
\newcommand{\wish}[2]{\ensuremath{\mathcal{W}(#1,#2)}}
\newcommand{\invwish}[2]{\ensuremath{\mathcal{IW}(#1,#2)}}
\newcommand{\gamdist}[2]{\ensuremath{\mathcal{G}(#1,#2)}}
\newcommand{\invgam}[2]{\ensuremath{\mathcal{IG}(#1,#2)}}
\newcommand{\studt}[3]{\ensuremath{t_{#3}(#1,#2)}}
\newcommand{\binomial}[2]{\ensuremath{\mathcal{B}in(#1,#2)}}
\newcommand{\bern}[1]{\ensuremath{\mathcal{B}ernoulli(#1)}}
\newcommand{\unif}[2]{\ensuremath{\mathcal{U}(#1,#2)}}
\newcommand{\chisqr}[1]{\ensuremath{\chi_{#1}^{2}}}
\newcommand{\invchisqr}[1]{\ensuremath{\mathcal{I}nv}\textnormal{-}\ensuremath{\chi_{#1}^{2}}}
\newcommand{\betadist}[2]{\ensuremath{\mathcal{B}eta(#1,#2)}}
\newcommand{\poisson}[1]{\ensuremath{\mathcal{P}oisson(#1)}}



% Bayes-related quantities
\newcommand{\bayes}{\ensuremath{\frac{f(y|\theta)\pi(\theta)}
                                {\int f(y|\theta)\pi(\theta)d\theta}}}
\newcommand{\marglik}{\ensuremath{\int f(y|\theta)\pi(\theta)d\theta}}
\newcommand{\bmi}{\ensuremath{ \frac{f(y|\theta)\pi(\theta)}{\pi(\theta|y)}}}


%General Math Stuff
\newcommand{\real}{\ensuremath{\mathbb{R}}}
%\newcommand{\implies}{\ensuremath{\Rightarrow}}
\newcommand{\I}{\ensuremath{I}}
\newcommand{\half}{\ensuremath{\frac{1}{2}}}
\newcommand{\quarter}{\ensuremath{\frac{1}{4}}}
\newcommand{\bs}{\boldsymbol}
\newcommand{\mb}{\mathbf}

%General Text Stuff
\newcommand{\dollars}{\$}
\newcommand{\percent}{\ensuremath{\%\;}}
