\input{../preamble.tex}

\subtitle{Lecture 5: Working with more than two categories}

<<echo=FALSE, warning=FALSE, message=FALSE>>=
source('../../shared-code/plotting.R')
theme_set(simplified.theme)


# for cps variable interpretation see https://www2.census.gov/programs-surveys/cps/datasets/2022/march/asec2022_ddl_pub_full.pdf
census.api.key = '8084f81e4f71e4d32638dac15f188b424f72d063'
library(cpsR)
library(dplyr)
library(magrittr)
library(kableExtra)
library(scales)

cps.data = cpsR::get_asec(year=2022, vars=c('h_numper', 'htotval', 'a_age', 'a_hga'), key=census.api.key)
all.earnings = data.frame(age=cps.data$a_age,
                          income=cps.data$htotval, 
                          education=case_match(cps.data$a_hga,
                                           0  ~ 0,   # child
                                           31 ~ 0,   # < grade 1
                                           32 ~ 4,   #  grade 1-4
                                           33 ~ 6,   #  grade 5-6
                                           34 ~ 8,   #  grade 7-8 
                                           35 ~ 9,   #  grade 9
                                           36 ~ 10,  #  grade 10
                                           37 ~ 11,  #  grade 11
                                           38 ~ 11,  #  grade 12 no diploma
                                           39 ~ 12,  #  high school grad
                                           40 ~ 13,  #  some college
                                           41 ~ 14,  #  associate degree (vocational)
                                           42 ~ 14,  #  associate degree (academic)
                                           43 ~ 16,  #  bachelors degree
                                           44 ~ 18,  #  masters degree
                                           45 ~ 20,  #  professional school degree
                                           46 ~ 20)) #  doctorate

in.interval = function(X, interval) { interval[1] <= X & X <= interval[2] }
earnings = all.earnings[all.earnings$age %>% in.interval(c(25,35)) & 
                        all.earnings$education >= 11, ]

earnings$raw.income = earnings$income
earnings$degree = factor(earnings$education >= 16, 
                     levels=c(FALSE, TRUE), 
                     labels=c('no 4-year degree','4-year degree')) 
rownames(earnings)=NULL
@

\begin{document}

\begin{frame}
\titlepage
\end{frame}

\section{Intuition}

\begin{frame}{CPS Income Data}
\begin{center}
So far, we've been looking at our income data as if people fall into two groups. \\
Our groups are people \textcolor{twocolor-green}{with} and \textcolor{twocolor-red}{without} 4-year degrees. Here's some of the data.
\end{center}
\bigskip
\begin{figure}
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
earnings.tab = earnings[1:12, c('income', 'degree')]
earnings.tab$income = sprintf('$%dk', round(earnings.tab$income / 1000))
earnings.tab %>% 
  kable() %>%
  kable_styling() %>%
  row_spec(which(earnings.tab$degree=='4-year degree'), background='twocolor-green') %>%
  row_spec(which(earnings.tab$degree!='4-year degree'), background='twocolor-red')
@
\end{figure}
\bigskip
\begin{center}
In what's shown here, most people with 4-year degrees make more than most without. \\
But not all of them. And this is just a small fraction of the data. Let's look at all of it.
\end{center}
\end{frame}

\begin{frame}{A Scatter Plot}
\begin{figure}
\only<1>{
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
ggplot(earnings) + geom_point(aes(x=degree, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) + 
                   scale_y_continuous(labels=label_dollar()) + 
                  theme(legend.position="none") 
@
}
\only<2>{
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
ggplot(earnings) + geom_point(aes(x=degree, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) + 
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   theme(legend.position="none") 
@
}
\end{figure}


\begin{overprint}
\only<1>{
\begin{itemize}
\item Here I've plotted one dot per person. 
\item There's lot of people, so the dots are all lying on top of one another. 
\item You can see what most people make by looking for a dark band.
\item But you really have to look carefully to compare them.
\item It's hard to see much because so little space is given to what most people make.
\item We need to do that to include people who make \emph{a lot of money}.
\end{itemize}
}
\only<2>{
\begin{itemize}
\item We can see things a bit better when we zoom in on people who make $\le \$300$k. \\
\item This leaves out a few millionaires, but that's mostly fine. We can do that.
\item And if that's still hard to work with, we can use another visualization.
\end{itemize}
}
\end{overprint}
\end{frame}

\begin{frame}{A Histogram}
\begin{figure}
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
ggplot(earnings[earnings$income<3e5, ]) + 
                   geom_histogram(aes(x=income, y=after_stat(density)), alpha=.5, bins=40) + 
                   coord_flip() + facet_wrap(~degree, strip.position='bottom') + aes(fill=degree) + 
                   scale_x_continuous(labels=label_dollar()) + 
                   theme(legend.position="none", axis.text.x = element_blank()) 
    
@
\end{figure}
\begin{itemize}
\item The bar length at each income level indicates the fraction \\
      of people that make roughly that amount of money.
\item You can see what most people make by looking for the peak.
\end{itemize}
\begin{center} Which group tends to make more money? And how much more? \end{center}
\visible<2>{
\begin{itemize}
\item People with 4 year degrees tend to make more.
\item Roughly \$50k more, comparing the two peaks.
\item TODO: Recall confidence statement about the mean from last week.
\end{itemize}
}
\end{frame}


\begin{frame}{Taking a Closer Look}
Using two categories is throwing away a lot of information about education. \\
We can, for example, categorize people by the \textbf{years of education} they've had. \\
\begin{figure}
\only<1-3>{
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none")
@
} 
\only<4>{
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
ggplot(earnings[earnings$income<3e5, ]) + 
                   geom_histogram(aes(x=income, y=after_stat(density)), alpha=.5, bins=40) + aes(fill=degree) + 
                   coord_flip() + facet_wrap(~education, strip.position='bottom', ncol=length(unique(earnings$education))) + 
                   scale_x_continuous(labels=label_dollar()) + 
                   theme(legend.position="none", axis.text.x = element_blank()) 
@
}
\end{figure}
\begin{overprint}
\only<1>{
This includes same information we were working with before. 
\[ \text{ 16 years education } \quad \implies \quad  \text{ 4-year degree } \]
If we shuffled all the red and green dots, we'd get the plot we had before. \\
} \only<2-3>{
But looking at it this way tells us more. \\
When we don't shuffle, we see an upward trend within each group.
\begin{center} What does this mean? \end{center}
\visible<3>{}
Even among people with (and without) a 4-year degree, \\
people with more education tend to make more money.
}
\only<4>{
And we aren't stuck looking for dark bands in scatter plots. \\
If we like, we can draw histograms broken down like this too.\\
}
\end{overprint}
\end{frame}

\begin{frame}{CPS Income Data by Years Education}
This does, of course, require that our survey asks about years of education. \\
And it does, more or less. The Current Population Survey includes lots of questions.\\

\begin{figure}
<<out.width='.8\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
earnings.tab = earnings[1:12, c('income', 'education', 'degree')]
earnings.tab$income = sprintf('$%dk', round(earnings.tab$income / 1000))
earnings.tab$education = sprintf('%d years', earnings.tab$education)
earnings.tab %>% 
  kable() %>%
  kable_styling() %>%
  row_spec(which(earnings.tab$degree=='4-year degree'), background='twocolor-green') %>%
  row_spec(which(earnings.tab$degree!='4-year degree'), background='twocolor-red')
@
\end{figure}
\begin{itemize}
\item The survey doesn't ask exactly this `how many years' question.
\item It takes a little pre-processing to get this.
\item And it takes a little care interpreting, too.
\item But we can more or less do it. That's part of data analysis.
\end{itemize}
\end{frame}


\begin{frame}[fragile]{Our pre-processing}
\begin{figure}
<<include=TRUE, eval=FALSE>>=
all.earnings = 
  data.frame(age=cps.data$a_age,
             income=cps.data$htotval, 
             education=case_match(cps.data$a_hga,
                          0  ~ 0,   # child
                          31 ~ 0,   # < grade 1
                          32 ~ 4,   #  grade 1-4
                          33 ~ 6,   #  grade 5-6
                          34 ~ 8,   #  grade 7-8 
                          35 ~ 9,   #  grade 9
                          36 ~ 10,  #  grade 10
                          37 ~ 11,  #  grade 11
                          38 ~ 11,  #  grade 12 no diploma
                          39 ~ 12,  #  high school grad
                          40 ~ 13,  #  some college
                          41 ~ 14,  #  associate degree (vocational)
                          42 ~ 14,  #  associate degree (academic)
                          43 ~ 16,  #  bachelors degree
                          44 ~ 18,  #  masters degree
                          45 ~ 20,  #  professional school degree
                          46 ~ 20)) #  doctorate
@          
\end{figure}
\end{frame}

\subsection{Some New Questions}

\begin{frame}[fragile]{What should I look at to answer these?}
\begin{minipage}{.45\linewidth}
\only<1,3,5,7,8>{
<<out.width='.9\\textwidth', fig.width=4, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none", 
                         axis.text.x = element_text(angle = -90, vjust = 0.5, hjust=1))
@
}
