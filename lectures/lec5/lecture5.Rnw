\begin{overprint}
\only<1-2>{ 
\begin{center}\textbf{Q.} \end{center}
\begin{enumerate}
\item  What's the typical income of a high school graduate that didn't attend college? 
\item  How varied are the incomes of these people?
\item  How many of them are there?
\end{enumerate}
\visible<2>{
\begin{center}\textbf{A.}\end{center}
We can answer these questions by looking at a group defined at a \\
\emph{finer resolution} than the \textcolor{twocolor-green}{4 year degree} vs. \textcolor{twocolor-red}{not} groups we've been using.
}
}
\only<3-4>{
\textbf{Q.} What's the typical difference in income between \ldots ?
\begin{enumerate}
\item \textcolor{twocolor-green}{A person with a 4-year degree and no further education.}
\item \textcolor{twocolor-red}{A person with a masters degree.}
\end{enumerate}
\visible<4>{
\begin{center}\textbf{A.}\end{center}
Same  deal. Now we're comparing groups defined at this finer resolution. \\
To indicate the groups we're comparing, we might want to recolor our data.
}
}
\only<5-6>{
\begin{center} \textbf{Q.}  \end{center}
\begin{enumerate}
\item What's the typical income of a person who has completed \\ high school but does not have a 4-year degree? \\
\item How varied the incomes of these people?
\end{enumerate}
\visible<6>{ 
\begin{center}\textbf{A.}\end{center}
To answer this question, we have to \emph{aggregate} data from multiple groups. \\
Our old aggregates, \textcolor{twocolor-green}{4-year degree} vs. \textcolor{twocolor-red}{no}, are irrelevant.
}
} 
\only<7-8> {
\textbf{Q.} What's the typical difference in income between \ldots ?
\begin{enumerate}
\item \textcolor{twocolor-green}{A person with a four year degree}
\item \textcolor{twocolor-red}{A person without one}
\end{enumerate}
\visible<8>{
\begin{center} \textbf{A.} \end{center}
This one we've done in previous lectures.\\
But now we're thinking of our old groups
as aggregates of smaller ones.
}
}
\end{overprint}
\end{frame}


\section{Calculating Descriptive Summaries}

\begin{frame}{Our Sample}
Our sample is the set of people who responded to the CPS and \ldots
\begin{itemize}
\item were between 25 and 35
\item were living alone
\item had at least an 11th-grade education
\end{itemize}

\begin{figure}
<<out.width='.45\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none", 
                         axis.text.x = element_text(angle = -90, vjust = 0.5, hjust=1))
@
\end{figure}
\begin{overprint}
\only<1>{
For each person, we observe two things.
\begin{align*}
X_i &= \text{years of education} \\
Y_i &= \text{income}
\end{align*}
}
\only<2>{
There are some groups we talk about associated with specific levels of $X_i$.
\begin{align*}
X_i & < 12 \implies \text{not a high school graduate} \\
X_i & = 12 \implies \text{high school graduate, no college} \\
X_i & = 13 \implies \text{attended college, no degree} \\
X_i & = 14 \implies \text{two-year college degree}   \\
X_i &\ge 16 \implies \text{four-year college degree} \\
X_i &> 16 \implies \text{graduate degree}
\end{align*}
}
\end{overprint}
\end{frame}


\begin{frame}{Some Questions, Formalized}

\begin{center}
<<out.width='.45\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=degree), position=position_jitter(w=.4), alpha=.2, 
                              data=earnings[earnings$education == 12, ]) +
                  geom_point(aes(x=education, y=income), position=position_jitter(w=.4), alpha=.005, 
                              data=earnings[earnings$education != 12, ]) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none", 
                         axis.text.x = element_text(angle = -90, vjust = 0.5, hjust=1))
@
\end{center}
\textbf{Q.} What's the \textbf{mean} income of high school graduates that didn't attend college? \\
\visible<2->{ 
\[ \overline{Y}_{X=12} = \frac{1}{N_{X=12}}\sum_{i:X_i=12} Y_i \quad \text{ where } \quad \overline{N}_{X=12} = \sum_{i:X_i=12} 1 \]
}
\textbf{Q.} What's the \textbf{standard deviation} of their incomes? \\
\visible<3-> {
\[ \sqrt{V_{X=12}} \quad \text{ where } \quad V_{X=12} = \frac{1}{N_{X=12}}\sum_{i:X_i=12} \p*{ Y_i - \overline{Y}_{X=12} }^2 \]
}
\textbf{Q.} What \textbf{proportion} of our sample graduated high school but didn't attend college? \\
\visible<4-> {
\[ \frac{N_{X=12}}{n} \]
}
\end{frame}


\begin{frame}{More}
\begin{center}
<<out.width='.45\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=education>16), position=position_jitter(w=.4), alpha=.2, 
                              data=earnings[earnings$education %in% c(16,18), ]) +
                  geom_point(aes(x=education, y=income), position=position_jitter(w=.4), alpha=.005, 
                              data=earnings[!(earnings$education %in% c(16,18)), ]) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none", 
                         axis.text.x = element_text(angle = -90, vjust = 0.5, hjust=1))
@
\end{center}
\textbf{Q.} What's the \textbf{mean} difference in income between \ldots ?
\begin{enumerate}
\item A person with a 4-year degree and no further education
\item A person with a masters degree
\end{enumerate}
\visible<2>{
\[ ... \]
}
\end{frame}

\begin{frame}{ More }
\begin{center}
<<out.width='.45\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=education > 12), position=position_jitter(w=.4), alpha=.2, 
                              data=earnings[earnings$education %in% c(12,13,14), ]) +
                  geom_point(aes(x=education, y=income), position=position_jitter(w=.4), alpha=.005, 
