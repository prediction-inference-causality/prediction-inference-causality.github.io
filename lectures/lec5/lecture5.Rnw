\begin{frame}{More}
\begin{center}
<<out.width='.45\\textwidth', fig.width=7, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=degree), position=position_jitter(w=.4), alpha=.2) +
                   scale_y_continuous(labels=label_dollar(), limits=c(0,3e5)) + 
                   scale_x_continuous(breaks=years, labels=sprintf('%d years', years)) + 
                   theme(legend.position="none", 
                         axis.text.x = element_text(angle = -90, vjust = 0.5, hjust=1))
@
\end{center}
\textbf{Q.} What's the \textbf{mean} difference in income between \ldots ?
\begin{enumerate}
\item A person with a four year degree
\item A person without one
\end{enumerate}
\visible<2>{
This is a familiar question. We answered it in the coarsened data...
\begin{align*} 
&\text{Do by averaging over people} \\
&\text{then rewrite as a weighted average over groups}
\end{align*}
}
\end{frame}

\section{Estimating Population Summaries}


\begin{frame}{Our Population}
\begin{itemize}
\item Our people are sampled uniformly at random from \\ 
      the set of all 2022 US residents that \ldots
\begin{itemize}
\item were between 25 and 35
\item were living alone
\item had at least an 11th-grade education
\end{itemize}
\item That's essentially true. 
\item The CPS is a uniformly-at-random sample of households in the census.
\item And we've excluded people who don't meet those criteria. \\
      \textcolor{lightgray}{TODO: Let's have talked about rejection sampling earlier.}
\item There are enough households that it's reasonable to act as if \\
      we've got independent samples from an infinite population. 
\item And we can formalize our questions as questions about this population.
\end{itemize}
\end{frame}

\end{document}
