<<out.width='.9\\textwidth', fig.width=4, fig.height=4, echo=FALSE, warning=FALSE>>=
years = unique(earnings$education)
ggplot(earnings) + geom_point(aes(x=education, y=income, color=education>16), position=position_jitter(w=.4), alpha=.2, 
