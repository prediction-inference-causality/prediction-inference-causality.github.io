cps.data = cpsR::get_asec(year=2022, vars=c('h_numper', 'htotval', 'a_age', 'a_hga','gereg', 'a_maritl', 'a_sex','peafever','a_wkstat'), key=census.api.key)
all.earnings = data.frame(age=cps.data$a_age,
income=cps.data$htotval,
education=case_match(cps.data$a_hga,
0  ~ 0,   # child
31 ~ 0,   # < grade 1
32 ~ 4,   #  grade 1-4
33 ~ 6,   #  grade 5-6
34 ~ 8,   #  grade 7-8
35 ~ 9,   #  grade 9
36 ~ 10,  #  grade 10
37 ~ 11,  #  grade 11
38 ~ 11,  #  grade 12 no diploma
