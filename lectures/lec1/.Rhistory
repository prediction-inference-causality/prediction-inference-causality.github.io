}
plot(mu.tilde,S.mu.tilde,type="l",lwd=2,col="red",xlab= expression(tilde(m)),ylab=expression(paste("S(",tilde(m),")")),main="Sum of Squared Residuals")
S1 <- function(mu.tilde,y){
sum(-2*y + 2*mu.tilde)
}
