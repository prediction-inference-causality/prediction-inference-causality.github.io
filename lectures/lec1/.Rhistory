education=case_match(cps.data$a_hga,
0  ~ 0,   # child
31 ~ 0,   # < grade 1
32 ~ 4,   #  grade 1-4
33 ~ 6,   #  grade 5-6
34 ~ 8,   #  grade 7-8
35 ~ 9,   #  grade 9
