hist(income,freq=FALSE,col="blue",ylim=c(-0.0000001,.0000075), xlab="Income")
lines(density(income),col="red",lwd=2)
rug(income,lwd=1.5)
hist(income,freq=FALSE,col="blue",ylim=c(-0.0000001,.0000075),xlab="Income")
lines(density(income),col="red",lwd=2)
hist(income,freq=FALSE,col="blue",ylim=c(-0.0000001,.0000075), xlab="Income")
lines(density(income),col="red",lwd=2)
points(x=mean(income),y=-.00000015,pch=2,cex=3,lwd=2,col="red")
points(x=median(income),y=-.00000015,pch="|",cex=3,lwd=2,col="red")
y <- income
mu.tilde <- seq(-2000000,2000000, by=500)
S <- function(mu.tilde,y){
sum((y-mu.tilde)^2)
}
S.mu.tilde <- rep(0,length(mu.tilde))
for(i in 1:length(mu.tilde)){
S.mu.tilde[i] <- S(mu.tilde[i],y)
}
plot(mu.tilde,S.mu.tilde,type="l",lwd=2,col="red",xlab= expression(tilde(m)),ylab=expression(paste("S(",tilde(m),")")),main="Sum of Squared Residuals")
S1 <- function(mu.tilde,y){
sum(-2*y + 2*mu.tilde)
}
plot(mu.tilde,S.mu.tilde,type="l",lwd=2,col="red",xlab= expression(tilde(m)),ylab=expression(paste("S(",tilde(m),")")),main="Sum of Squared Residuals")
abline(a=S(mu.tilde=1000000,y=y) - 1000000*S1(mu.tilde=1000000,y=y),b=S1(mu.tilde=1000000,y=y),lwd=2,col="blue")
text(x=1000000,y=0,labels="|",col="blue",cex=2)
plot(mu.tilde,S.mu.tilde,type="l",lwd=2,col="red",xlab= expression(tilde(m)),ylab=expression(paste("S(",tilde(m),")")),main="Sum of Squared Residuals")
abline(a=S(mu.tilde=500000,y=y) - 500000*S1(mu.tilde=500000,y=y),b=S1(mu.tilde=500000,y=y),lwd=2,col="blue")
text(x=500000,y=0,labels="|",col="blue",cex=2)
plot(mu.tilde,S.mu.tilde,type="l",lwd=2,col="red",xlab= expression(tilde(m)),ylab=expression(paste("S(",tilde(m),")")),main="Sum of Squared Residuals")
abline(a=S(mu.tilde=mean(income),y=y) - mean(income)*S1(mu.tilde=mean(income),y=y),b=S1(mu.tilde=mean(income),y=y),lwd=2,col="blue")
text(x=mean(income),y=0,labels="|",col="blue",cex=2)
hist(income,freq=FALSE,col="blue",ylim=c(-0.0000001,.0000075), xlab="Income")
lines(density(income),col="red",lwd=2)
points(x=mean(income),y=0,pch=2,cex=3,lwd=2,col="red")
points(x=mean(income)-sd(income),y=0,pch="[",cex=2,lwd=2,col="red")
points(x=mean(income)+sd(income),y=0,pch="]",cex=2,lwd=2,col="red")
hist(income,freq=FALSE,col="blue",ylim=c(-0.0000001,.0000075),xlab="Income",main="At most 25% outside of 2 SDs")
lines(density(income),col="red",lwd=2)
points(x=mean(income),y=0,pch=2,cex=3,lwd=2,col="red")
points(x=mean(income)-2*sd(income),y=0,pch="[",cex=2,lwd=2,col="red")
points(x=mean(income)+2*sd(income),y=0,pch="]",cex=2,lwd=2,col="red")
earnings$fouryrdegree<- ifelse(earnings$degree=="4-year degree", 1,0)
