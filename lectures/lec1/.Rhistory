ggplot(laborforce, aes(x=degree, y=employed)) + geom_point(shape=1) +geom_point(aes(y=mean(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=17,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=17,size=3)  + geom_abline(intercept = intercept2, slope = slope2, color="red", linetype="dashed")
ggplot(laborforce, aes(x=degree, y=employed)) + geom_jitter(shape=1) +geom_point(aes(y=mean(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=17,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=17,size=3)  + geom_abline(intercept = intercept2, slope = slope2, color="red", linetype="dashed")
ggplot(laborforce, aes(x=degree, y=employed)) + geom_point(shape=1) +geom_point(aes(y=mean(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=17,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=17,size=3)  + geom_abline(intercept = intercept2, slope = slope2, color="red", linetype="dashed") + geom_point(aes(y=mean(employed[fouryrdegree==0])-sd(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=3,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==0])+sd(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=3,size=3) +
geom_point(aes(y=mean(employed[fouryrdegree==1])+sd(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=3,size=3) +  geom_point(aes(y=mean(employed[fouryrdegree==1])-sd(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=3,size=3)
ggplot(laborforce, aes(x=degree, y=employed)) + geom_jitter(shape=1) +geom_point(aes(y=mean(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=17,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=17,size=3)  + geom_abline(intercept = intercept2, slope = slope2, color="red", linetype="dashed") + geom_point(aes(y=mean(employed[fouryrdegree==0])-sd(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=3,size=3) + geom_point(aes(y=mean(employed[fouryrdegree==0])+sd(employed[fouryrdegree==0]),x="no 4-year degree"),colour="red",shape=3,size=3) +
geom_point(aes(y=mean(employed[fouryrdegree==1])+sd(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=3,size=3) +  geom_point(aes(y=mean(employed[fouryrdegree==1])-sd(employed[fouryrdegree==1]),x="4-year degree"),colour="red",shape=3,size=3)
