asf17new <- read.csv("2018_2017 ASF Events for Data Analysis - 2017 new events.csv")
asf17repeat <- read.csv("2018_2017 ASF Events for Data Analysis - 2017 repeat events.csv")
View(asf17new)
asf17 <- rbind(asf17repeat,asf17new)
View(asf17)
dim(asf17)
dim(asf17new)
dim(asf17repeat)
asf17$Act_Est <- asf17$Actual.Attendance - asf17$Estimated.Attendance
hist(asf17$Act_Est)
plot(kernel(asf17$Act_Est))
summary(asf17$Act_Est)
asf17 <- na.omit(asf17)
summary(asf17$Act_Est)
dim(asf17)
plot(kernel(asf17$Act_Est))
plot(density(asf17$Act_Est))
?plot
plot(asf17$Estimated.Attendance,asf17$Actual.Attendance)
summary(asf17$Act_Est)
asf17 <- subset(asf17,Actual.Attendance < 5000)
plot(asf17$Estimated.Attendance,asf17$Actual.Attendance)
asf17 <- rbind(asf17repeat,asf17new)
dim(asf17)
asf17 <- na.omit(asf17)
dim(asf17)
asf17$Act_Est <- asf17$Actual.Attendance - asf17$Estimated.Attendance
save(asf17,file="asf17.RData")
load(asf17.RData)
load("asf17.RData")
View(asf17)
plot(asf17$Estimated.Attendance,asf17$Actual.Attendance)
asf17s <- subset(asf17,Actual.Attendance < 5000)
plot(asf17s$Estimated.Attendance,asf17s$Actual.Attendance)
asf.lm <- lm(Actual.Attendance ~ Estimated.Attendance, data=asf17s)
abline(asf.lm)
asf.lm2 <- lm(Actual.Attendance ~ Estimated.Attendance + I(Estimated.Attendance^2), data=asf17s)
x <- seq(0,1000,1)
lines(x,-42 + 2.35*x  - .00152*x^2)
asf.lm3 <- lm(Actual.Attendance ~ Estimated.Attendance + I(Estimated.Attendance^2) + I(Estimated.Attendance^3), data=asf17s)
x <- seq(0,1000,1)
lines(x,asf.lm3$coef[1] + asf.lm3$coef[2]*x + asf.lm3$coef[3]*x^2 + asf.lm3$coef[4]*x^3)
summary(asf.lm)
plot(asf.lm)
plot(asf.lm,which=1)
plot(asf.lm,which=2)
