n <- 100#
S <- 100#
cover <- rep(NA,S)#
for(s in 1:S){#
	y <- rexp(n)#
	cover[s] <- mean(y) - 1.282*sd(y)/sqrt(n) < 1 & mean(y) + 1.282*sd(y)/sqrt(n) > 1#
}
cover
