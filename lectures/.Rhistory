#| label: table-styling
ellipsis = function(df, nhead=5L, ntail=2) {
rownames(df) = as.character(1:nrow(df))
stopifnot("data.frame" %in% class(df))
els = rep(NA, ncol(df)) |>
matrix(nrow=1, dimnames=list(NULL, names(df))) |>
data.frame(stringsAsFactors=FALSE) |>
as_tibble()
rownames(els) = "⋮"
dplyr::bind_rows(head(df, nhead), els, tail(df, ntail))
}
options(knitr.kable.NA = '')
#| label: with-seed
with_seed = function(thunk, seed) {
current.seed = .Random.seed
set.seed(seed)
result = thunk()
set.seed(current.seed)
result
}
#| label: ggplot-utils
mean_sd = function(x, mult = 1) { mean_se(x, mult = mult*sqrt(length(stats::na.omit(x)))) }
#| label: coarsen
coarsen = function(x, group, seed=0) {
with_seed(function(seed) {
x.coarsened = rep(NA, length(x))
for(gg in unique(group)) {
x.coarsened[group==gg] = runif(sum(group==gg), min(x[group==gg]), max(x[group==gg]))
}
x.coarsened
}, seed=seed)
}
#| label: calibrated-width
width = function(samples, center=mean(samples), alpha=.05) {
limits = c(0, 2*max(abs(samples-center)))
covg_dif = function(w) {
actual = mean(center - w/2 <= samples & samples <= center + w/2)
nominal = 1-alpha
actual - nominal
}
uniroot(covg_dif, interval=limits)$root
}
width_cdf = function(cdf, center, limits, alpha=.05) {
covg_dif = function(w) {
actual = cdf(center + w/2) - cdf(center - w/2)
nominal = 1-alpha
actual - nominal
}
uniroot(covg_dif, interval=limits)$root
}
#| label: distribution-plot-annotations
default.dot.size = 2
default.highlight.colors = c(polla, pollb, pollc, polld)
default_height = function(samples) { dnorm(0, mean=0, sd=sd(samples)) }
# fussy code to make sure the heights of the highlighted
# dots don't change when the total number of dots changes
annotation_dot_heights = function(dots, highlight.dots, height, seed=default.seed) {
heights = (\(){
highlight.dot.heights = sample(1:highlight.dots)/(highlight.dots + 1)
unhighlighted.dot.heights = setdiff(sample(1:dots), 1:highlight.dots)/(dots + 1)
height*c(highlight.dot.heights[1:min(dots,highlight.dots)],
unhighlighted.dot.heights)
}) |> with_seed(seed)
heights
}
with_annotations = function(samples,
estimand = NA,
shade.width = NA, shade.color='green', shade.alpha=.15,
dots=100, interval.width=NA,
dot.size = default.dot.size,
highlight.dots=3,
highlighted.dot.alpha=1,
unhighlighted.dot.alpha=.15,
height=default_height(samples),
seed=default.seed) {
highlight.colors = if(highlight.dots) default.highlight.colors[1:min(dots,highlight.dots)] else c()
summary.data = data.frame(
mu=mean(samples),
w66 = width(samples, alpha=1/3),
w95 = width(samples, alpha=.05),
shade.width=shade.width,
estimand=estimand)
estimand.geom = if(is.na(summary.data$estimand)) geom_blank() else
geom_vline(aes(xintercept=estimand),
color='green', size=3, alpha=.8,
data=summary.data)
shade.geom = if(is.na(summary.data$shade.width)) geom_blank() else
geom_rect(aes(xmin=mu-shade.width/2,
xmax=mu+shade.width/2, ymin=0, ymax=Inf),
fill=shade.color, alpha=shade.alpha,
data=summary.data)
dot.geom = if(dots == 0) geom_blank() else {
heights = annotation_dot_heights(dots, highlight.dots, height, seed)
dot.data = data.frame(
x=samples[1:dots],
y=heights,
w=interval.width,
color=c(highlight.colors,
rep('purple', dots-length(highlight.colors))),
alpha=c(rep(highlighted.dot.alpha,   length(highlight.colors)),
rep(unhighlighted.dot.alpha, dots-length(highlight.colors))))
if(is.na(interval.width))
geom_point(aes(y=y, x=x, color=I(color), alpha=I(alpha)),
size=dot.size, data=dot.data)
else
geom_pointrange(aes(y=y, x=x, xmin=x-w/2, xmax=x+w/2, color=I(color), alpha=I(alpha)),
size=dot.size/4, linewidth=dot.size/4, data=dot.data)
}
geoms = list(estimand.geom, shade.geom, dot.geom,
geom_vline(aes(xintercept=mu), color="blue", data=summary.data),
geom_vline(aes(xintercept=mu-w66/2), color="blue", linetype='dashed', data=summary.data),
geom_vline(aes(xintercept=mu+w66/2), color="blue", linetype='dashed', data=summary.data),
geom_vline(aes(xintercept=mu-w95/2), color="blue", linetype='dotted', data=summary.data),
geom_vline(aes(xintercept=mu+w95/2), color="blue", linetype='dotted', data=summary.data))
geoms
}
#| label: last-shared-code-chunk
#| label: ga-turnout-setup
#| include: false
library(tidyverse)
#| label: ga-maps
#| cache: true
# The county info is from https://en.wikipedia.org/wiki/List_of_counties_in_Georgia
# and has been converted to csv using https://wikitable2csv.ggor.de
to.number = function(s) { as.numeric(str_trim(gsub(",", "", s))) }
ga_county_info = read.csv('data/georgia_county_info.csv') |>
mutate(subregion = tolower(sub(' County', '', County))) |>
mutate(pop =  to.number(Population)) |>
mutate(area = to.number(sub('sq.*', '', Area)))
counties = map_data('county', region='georgia')
ga_county = counties |>
filter(region == "georgia")
ga_county = left_join(ga_county, ga_county_info, by=c('subregion'='subregion'))
ga_county$subregion = gsub("de kalb", "dekalb", ga_county$subregion)
# Create fake locations for the people in our population
# by taking random convex combinations of county vertices
# To reduce computation, we'll have 10K locations + jitter
sample.within.subregion = function(subregions, seed=1) {
output = data.frame(subregion=subregions, lat=NA, long=NA)
for(subregion in unique(subregions)) {
vertices = ga_county[ga_county$subregion==subregion, c('lat','long')]
U = sum(subregions==subregion)
V = nrow(vertices)
weights = abs(rt(U*V, 1))
dim(weights) = c(U,V)
weights = (1/rowSums(weights)) * weights
output[subregions==subregion, c('lat', 'long')] =
cbind(weights %*% vertices$lat, weights %*% vertices$long)
}
output
}
L = 10000
county = sample(ga_county_info$subregion, size=L, replace=T, prob=ga_county_info$pop)
base.locations = sample.within.subregion(county)
#| label: make-state-maps
# Make maps of California with and without population density shown
state.plot = ggplot(data=ga_county, mapping=aes(x=long, y=lat, group=group)) +
coord_quickmap() +
geom_polygon(fill='gray', color = "white", alpha=.4) +
scale_fill_gradient(trans="log10") +
theme_void()
state.pop.plot = ggplot(data=ga_county, mapping=aes(x=long, y=lat, group=group)) +
coord_quickmap() +
geom_polygon(aes(fill = pop/area), color = "white") +
scale_fill_gradient(trans="log10") +
theme_void()
#| label: ga-population
set.seed(4)
m = 7233584
n = 625
b0 = floor(.7*m)
b1 = ceiling(.3*m)
y0 = rbinom(n=b0,size=1,prob=.68)
y1 = rbinom(n=b1,size=1,prob=.74)
pop = data.frame(y=c(y0,y1), x=c(rep(0,b0),rep(1,b1)))
pop = pop[sample(1:m),] # shuffle the rows
x = pop$x
y = pop$y
#| label: ga-population-xy
# Create fake locations for the people in our population
base.ind = 1 + ( (0:(m-1)) %% L )
locations = base.locations[base.ind,]
pop$lat  = locations$lat  + rnorm(m, sd=.01)
pop$long = locations$long + rnorm(m, sd=.01)
pop$group = 1 # for ggplot mapping
#| label: ga-sample
# Generate Sample Data for us (J1) and three friends (J2,J3,JM)
set.seed(0)
J1 = sample(1:m,size=n,replace=T)
J2 = sample(1:m,size=n,replace=T)
J3 = sample(1:m,size=n,replace=T)
JM = sample(1:m,size=n,replace=T)
J = J1
sam = pop[J,]
#| label: plot-ga-sample-and-population
# Now we'll plot the sample and the population on the map.
# Probably in the future this should be done in the lecture file,
# as we may want them colored differently lecture by lecture.
sample.plot = state.plot + geom_point(aes(x=long, y=lat), data=sam, size=.2, alpha=.5)
sample.plot.inf = state.pop.plot + geom_point(aes(x=long, y=lat), data=sam, size=.2, alpha=.5)
pop.plot    = state.plot + geom_point(aes(x=long, y=lat), data=pop[1:L, ], size=.02, alpha=.1)
pop.plot.inf = state.pop.plot + geom_point(aes(x=long, y=lat), data=pop[1:L, ], size=.01, alpha=.1)
#| label: old-names
dfsam = sam
X = sam$x
Y = sam$y
dfpop = pop
x = pop$x
y = pop$y
#| label: last-ga-turnout-chunk
#| label: ca-income-setup
#| include: false
library(ggplot2)
source('income.R')
#| label: load-ca-data
#| cache: true
california.state.code = 6
ca_income = income(california.state.code)
#| label: make-ca-maps
# Make maps of California with and without population density shown
ca.plot = ggplot(data=ca_income$info, mapping=aes(x=long, y=lat, group=group)) +
coord_quickmap() +
geom_polygon(fill='gray', color = "white", alpha=.4) +
scale_fill_gradient(trans="log10") +
theme_void()
ca.pop.plot = ggplot(data=ca_income$info, mapping=aes(x=long, y=lat, group=group)) +
coord_quickmap() +
geom_polygon(aes(fill = pop/area), color = "white") +
scale_fill_gradient(trans="log10") +
theme_void()
#| label: fake-ca-population
#| cache: true
# For illustration purposes, we're going to make up a fake population that we can think of our sample as being drawn from.
# We'll make up a population as follows
# 1. choose the number of people to be the number of people in our sample scaled up to account for the cps sampling ratio.
#    Or, really, a smaller ratio that's more usable visually.
# 2. draw units with replacement from the sample to get a set of rows to *add to the sample* to get the population
# 3. tweak these new rows to make them a bit different
#  - perturb the income in these new rows by income by multiplying by 1*.1U for U uniform on [-1, 1].
#  - perturb their location by resampling their location from their subregion
# 4. combine the sample and the added rows to get the population, shuffling so the sample isn't at the top
#    we'll save the indices of the sample rows in the population as 'J' so we can refer to them later.
earnings = ca_income$sample
earnings$degree = factor(earnings$education >= 16, # we use this dichotomization a lot early on
levels=c(FALSE, TRUE),
labels=c('no 4-year degree','4-year degree'))
earnings$group = 1                     # we need this for mapping
cps.sampling.ratio = 1/2500            # the actual one
plotting.cps.sampling.ratio=1/12.5     # works well visually
plotting.cps.sampling.ratio=1/6.25     # an unfortunate concession to github's file-size requirements
npop = round(nrow(earnings) / plotting.cps.sampling.ratio)
pop.seed = 1
newtopop = earnings[(\()sample(1:nrow(earnings), npop-nrow(earnings), replace=TRUE)) |> with_seed(pop.seed), ]
newtopop$income = newtopop$income*(1 + .1 * runif(nrow(newtopop), -1, 1))
newlocations = ca_income$sample_location(newtopop$county, seed=2)
newtopop$lat  = newlocations$lat
newtopop$long = newlocations$long
pop.earnings = rbind(earnings, newtopop)
order = (\() sample(1:nrow(pop.earnings))) |> with_seed(pop.seed)
J=order[1:nrow(earnings)]
pop.earnings[order, ] = pop.earnings
#| label:  define-old-names-for-ca-stuff
# Now we'll define a bunch of stuff that's used in older lectures
# where the fake population and sample had a more awkward relationship
display.population = pop.earnings
pop.tab = pop.earnings
our.sample = earnings
sample.tab = earnings
sample.tab$J = J
#| label: plot-ca-sample-and-population
# Now we'll plot the sample and the population on the map.
# Probably in the future this should be done in the lecture file,
# as we may want them colored differently lecture by lecture.
sample.plot = ca.plot + geom_point(aes(x=long, y=lat), data=earnings, size=.2, alpha=.5)
sample.plot.inf = ca.pop.plot + geom_point(aes(x=long, y=lat), data=earnings, size=.2, alpha=.5)
pop.plot = ca.plot + geom_point(aes(x=long, y=lat), data=pop.earnings, size=.02, alpha=.1)
pop.plot.inf = ca.pop.plot + geom_point(aes(x=long, y=lat), data=pop.earnings, size=.01, alpha=.1)
#| label: visualization-defaults
## default settings for our scatter plot
scale_y = function(limits=c(0, 2e5)) {
list(scale_y_continuous(breaks=seq(0, max(limits), by=25e3),
labels=label_dollar(scale=1e-3, suffix='k')),
coord_cartesian(ylim=limits))
}
years = 8:20
scale_x = function(limits=c(min(years)-.5, max(years)+.5)) {
scale_x_continuous(breaks=years, labels=sprintf('%dy', years), limits=limits)
}
dot.size = 2
#| label: last-ca-income-chunk
