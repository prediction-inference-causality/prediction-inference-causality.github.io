#!/bin/zsh

WEBSITE=$HOME/work/teaching/qtm285-1.github.io/_site
ASSETTYPE=$(basename `pwd`) 

quarto render $1;
cp `basename $1 .qmd`.html $WEBSITE/assets/$ASSETTYPE;

cd $WEBSITE;
git add assets/$ASSETTYPE/`basename $1 .qmd`.html;
git commit -m "scripted: updated lecture `basename $1 .qmd`";

if [ ! -z $2 ] && [ $2  = 'push' ]; then
    git push;
fi 