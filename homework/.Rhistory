y.bar<- mean(CLlib)
s.resid<- rep(0,length(CLlib))
for(i in 1:length(CLlib)){
s.resid[i] <- (CLlib[i] - y.bar)^2
}
sqrt(sum(s.resid)/(length(CLlib)-1))
